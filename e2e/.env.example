# Copy to .env and adjust. Never commit real credentials.

# Site under test (the apex technerdsng.com currently does not resolve; www does)
BASE_URL=https://www.technerdsng.com
APEX_URL=https://technerdsng.com

# Optional: a dedicated *test* editor account for the authenticated admin specs.
# Leave blank to skip them. Use an email+password Clerk account, not Google SSO.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Performance budgets (milliseconds / bytes / unitless). Defaults follow Core Web Vitals "good".
PERF_TTFB_MS=800
PERF_FCP_MS=1800
PERF_LCP_MS=2500
PERF_CLS=0.1
PERF_LOAD_MS=5000
PERF_JS_BYTES=700000
PERF_TOTAL_BYTES=3000000

# Light load check (kept gentle on purpose - this is production)
LOAD_CONCURRENCY=10
LOAD_P95_MS=2000
